# ─────────────────────────────────────────────────────────────
# Homebox Pricer — environment configuration
# Copy to .env and fill in. Only HOMEBOX_TOKEN (or the user/pass
# pair) is strictly required to get started.
# ─────────────────────────────────────────────────────────────

# --- Homebox (shared) ---------------------------------------------------
HOMEBOX_URL=http://172.16.0.125:3900

# Auth: provide EITHER a static token OR login credentials (for auto-refresh).
# Credentials take precedence if both are set.
HOMEBOX_TOKEN=replace-with-your-bearer-token
# HOMEBOX_USER=you@example.com
# HOMEBOX_PASSWORD=your-password

# --- Homebox Companion (capture UI) -------------------------------------
# Points Companion at the local Ollama vision model instead of a paid API.
HBC_LLM_API_KEY=not-needed-for-local
HBC_LLM_API_BASE=http://ollama:11434
HBC_LLM_MODEL=ollama/qwen2.5vl:3b
HBC_LLM_ALLOW_UNSAFE_MODELS=true
# Companion needs the same Homebox URL:
HBC_HOMEBOX_URL=http://172.16.0.125:3900

# --- price-lookup sidecar -----------------------------------------------
# Reuses the SAME model as capture (one model resident on 8 GB VRAM).
OLLAMA_URL=http://ollama:11434
PRICE_TEXT_MODEL=qwen2.5vl:3b
PRICE_REGION=au-en
PRICE_CURRENCY=AUD
PRICE_MIN_CONFIDENCE=low
CHECK_INTERVAL=3600
SERVER_PORT=8090
DB_PATH=/data/price.db
