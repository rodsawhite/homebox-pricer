# ─────────────────────────────────────────────────────────────
# Homebox Pricer — environment configuration
# Copy to .env and fill in. Only HOMEBOX_TOKEN (or the user/pass
# pair) is strictly required to get started.
# ─────────────────────────────────────────────────────────────

# --- Homebox (shared) ---------------------------------------------------
HOMEBOX_URL=http://172.16.0.125:3900

# Auth: provide EITHER a static token OR login credentials (for auto-refresh).
# Credentials take precedence if both are set.
HOMEBOX_TOKEN=replace-with-your-bearer-token
# HOMEBOX_USER=you@example.com
# HOMEBOX_PASSWORD=your-password

# --- Homebox Companion (capture UI, port 8090) --------------------------
# Capture uses Anthropic's Claude Haiku 4.5 (cloud vision) to identify items.
# Companion resolves Anthropic natively — no HBC_LLM_API_BASE needed.
# Use the full versioned model ID (e.g. claude-haiku-4-5-20251001).
HBC_LLM_API_KEY=sk-ant-replace-with-your-anthropic-key
HBC_LLM_MODEL=anthropic/claude-haiku-4-5-20251001
# Companion needs the same Homebox URL:
HBC_HOMEBOX_URL=http://172.16.0.125:3900

# --- price-lookup sidecar -----------------------------------------------
# Pricing stays local: a lean text-only model on Ollama parses search
# snippets. Capture no longer needs a local vision model, so this is a small
# text model rather than the heavier vision-language one.
OLLAMA_URL=http://ollama:11434
PRICE_TEXT_MODEL=qwen2.5:3b
PRICE_REGION=au-en
PRICE_CURRENCY=AUD
PRICE_MIN_CONFIDENCE=low
CHECK_INTERVAL=3600
SERVER_PORT=8091
DB_PATH=/data/price.db
