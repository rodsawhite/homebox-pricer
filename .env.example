# ─────────────────────────────────────────────────────────────
# Homebox Pricer — environment configuration
# Copy to .env and fill in. Only HOMEBOX_TOKEN (or the user/pass
# pair) and HOMEBOX_URL are required to get started.
# ─────────────────────────────────────────────────────────────

# --- Homebox ---------------------------------------------------------------
# The NAS/server where your Homebox instance runs.
HOMEBOX_URL=http://172.16.0.125:3900

# Auth: provide EITHER a static token OR login credentials (for auto-refresh).
# Credentials take precedence if both are set. Tokens expire ~monthly.
HOMEBOX_TOKEN=replace-with-your-bearer-token
# HOMEBOX_USER=you@example.com
# HOMEBOX_PASSWORD=your-password

# --- price-lookup sidecar --------------------------------------------------
# Pricing uses a lean local text model on Ollama to parse web search snippets.
# No Anthropic key needed here — capture/vision is Companion's job, not ours.
OLLAMA_URL=http://ollama:11434
PRICE_TEXT_MODEL=qwen2.5:3b
PRICE_REGION=au-en
PRICE_CURRENCY=AUD

# Hide candidates below this confidence in the review queue (low|medium|high).
# Sub-threshold candidates are still stored — reveal them with ?include_all=true.
PRICE_MIN_CONFIDENCE=low

# Fetch the top N search-result pages and scrape structured price data
# (JSON-LD offers.price / og:price meta tags) so the model sees real prices,
# not just snippets that often omit them. 0 = snippets only (no page fetch).
PRICE_FETCH_PAGES=3
PRICE_FETCH_TIMEOUT=8.0

CHECK_INTERVAL=3600
SERVER_PORT=8091
DB_PATH=/data/price.db

# Log output style: "plain" (human-readable, default) or "json" (structured,
# one JSON object per line — useful if you're feeding logs to a log shipper).
LOG_FORMAT=plain

# --- Homebox Companion (NOT managed by this compose file) ------------------
# Companion handles photo capture and AI item identification. It runs as a
# separate container — see https://github.com/Duelion/homebox-companion for
# setup. Key vars you'll need in its own env:
#
#   HBC_LLM_API_KEY=sk-ant-...          # Anthropic key for Claude Haiku 4.5
#   HBC_LLM_MODEL=anthropic/claude-haiku-4-5-20251001
#   HBC_HOMEBOX_URL=http://172.16.0.125:3900
#   HBC_SERVER_HOST=0.0.0.0
#   HBC_SERVER_PORT=8090
